np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import tensorflow as tf\n","from tensorflow.keras.models import Sequential\n","from tensorflow.keras.layers import Conv2D, MaxPooling2D, Flatten, Dense, Dropout, BatchNormalization\n","from tensorflow.keras.utils import to_categorical\n","from tensorflow.keras.preprocessing.image import ImageDataGenerator\n","from sklearn.model_selection import train_test_split\n","\n","# Load data\n","train = pd.read_csv('/kaggle/input/fashionmnist/fashion-mnist_train.csv')\n","test = pd.read_csv('/kaggle/input/fashionmnist/fashion-mnist_test.csv')\n","\n","# Extract data\n","train_labels = train['label'].values\n","train_images = train.drop('label', axis=1).values\n","test_labels = test['label'].values\n","test_images = test.drop('label', axis=1).values\n","\n","# Class names\n","class_names = [\n","    'T-shirt/top', 'Trouser', 'Pullover', 'Dress', 'Coat',\n","    'Sandal', 'Shirt', 'Sneaker', 'Bag', 'Ankle boot'\n","]\n","\n","# Normalize and reshape\n","train_images = train_images.reshape(-1, 28, 28, 1) / 255.0\n","test_images = test_images.reshape(-1, 28, 28, 1) / 255.0\n","\n","# One-hot encode labels\n","train_labels = to_categorical(train_labels, num_classes=10)\n","test_labels = to_categorical(test_labels, num_classes=10)\n","\n","# Data augmentation specifically helpful for dresses\n","datagen = ImageDataGenerator(\n","    rotation_range=15,\n","    width_shift_range=0.1,\n","    height_shift_range=0.1,\n","    zoom_range=0.1,\n","    shear_range=0.1,\n","    horizontal_flip=True\n",")\n","\n","# Enhanced model architecture with focus on dress features\n","model = Sequential([\n","    Conv2D(32, (3,3), activation='relu', input_shape=(28,28,1)),\n","    BatchNormalization(),\n","    MaxPooling2D((2,2)),\n","    \n","    Conv2D(64, (3,3), activation='relu'),\n","    BatchNormalization(),\n","    MaxPooling2D((2,2)),\n","    \n","    Conv2D(128, (3,3), activation='relu'),\n","    BatchNormalization(),\n","    Dropout(0.3),\n","    \n","    Flatten(),\n","    Dense(256, activation='relu'),\n","    BatchNormalization(),\n","    Dropout(0.5),\n","    Dense(10, activation='softmax')\n","])\n","\n","# Custom metrics to monitor dress performance\n","from tensorflow.keras.metrics import CategoricalAccuracy, Precision, Recall\n","metrics = [\n","    CategoricalAccuracy(name='accuracy'),\n","    Precision(class_id=3, name='dress_precision'),\n","    Recall(class_id=3, name='dress_recall')\n","]\n","\n","model.compile(optimizer='adam',\n","              loss='categorical_crossentropy',\n","              metrics=metrics)\n","\n","model.summary()\n","\n","# Train with augmented data\n","history = model.fit(\n","    datagen.flow(train_images, train_labels, batch_size=64),\n","    epochs=15,\n","    validation_data=(test_images, test_labels)\n",")\n","\n","# Save model\n","model.save(\"fashion-mnist-project.h5\")\n","print(\"✅ Model saved!\")\n","\n","# Plot training history\n","plt.figure(figsize=(12, 5))\n","plt.subplot(1, 2, 1)\n","plt.plot(history.history['accuracy'], label='Train Accuracy')\n","plt.plot(history.history['val_accuracy'], label='Validation Accuracy')\n","plt.title('Accuracy')\n","plt.legend()\n","\n","plt.subplot(1, 2, 2)\n","plt.plot(history.history['dress_precision'], label='Dress Precision')\n","plt.plot(history.history['dress_recall'], label='Dress Recall')\n","plt.title('Dress-specific Metrics')\n","plt.legend()\n","plt.show()\n","\n","# Evaluate on test set\n","test_loss, test_acc, test_dress_precision, test_dress_recall = model.evaluate(test_images, test_labels)\n","print(f\"\\nTest Accuracy: {test_acc*100:.2f}%\")\n","print(f\"Dress Precision: {test_dress_precision*100:.2f}%\")\n","print(f\"Dress Recall: {test_dress_recall*100:.2f}%\")"]}],"metadata":{"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"datasetId":2243,"sourceId":9243,"sourceType":"datasetVersion"}],"dockerImageVersionId":31089,"isGpuEnabled":true,"isInternetEnabled":false,"language":"p